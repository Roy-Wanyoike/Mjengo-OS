# Build-context hygiene, mirroring the root .dockerignore: nothing here is
# needed to build or run the image, and some of it (data/, *.log, .env*) must
# NEVER enter a layer. NEXT_PUBLIC_* values reach the build via ARGs, runtime
# env via `docker run`/compose — never from files in the context.

# dependencies & build state (rebuilt inside the image)
node_modules
.next
out
build

# secrets & local config (.env* incl. .env.example — the build uses ARGs)
.env*

# local runtime state, logs, pid files (contact-form submissions are
# runtime data, not source)
data
*.log
*.pid
dev.log
dev.out.log

# os cruft
.DS_Store
Thumbs.db
