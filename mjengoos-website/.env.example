# ── MjengoOS marketing website — environment ─────────────────────────────
# Copy to .env and adjust. Every variable is optional; the site runs fine
# with none of them set.

# Canonical public URL of the website (used for SEO metadata / sitemap).
# In local dev the default (http://localhost:3001) is used automatically.
NEXT_PUBLIC_SITE_URL="https://mjengoos.example.com"

# Where "Sign in" points — the actual MjengoOS application.
# When the site is served behind a gateway with the app on the same host
# (as in the preview sandbox), the default "/" is correct. Otherwise set
# the app's public origin, e.g. "https://app.mjengoos.com".
NEXT_PUBLIC_APP_URL="/"

# Optional analytics sink. When set, tracked events are POSTed here as
# JSON ({ event, props, ts, url }). When unset, events are only logged to
# the browser console in development — no analytics provider is contacted.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT="https://analytics.example.com/collect"

# Serve the site under a base path — used in the integrated preview mode,
# where the web app (port 3000) proxies /website/* to this server (port 3001).
# The site then serves pages, assets and its API under that prefix.
# Leave unset for a standalone deployment on its own domain.
# NEXT_PUBLIC_BASE_PATH="/website"
