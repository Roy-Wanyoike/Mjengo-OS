# ── MjengoOS marketing website — environment ─────────────────────────────
# Copy to .env and adjust. Every variable is optional; the site runs fine
# with none of them set.

# Canonical public URL of the website (used for SEO metadata / sitemap).
# In local dev the default (http://localhost:3001) is used automatically.
# IMPORTANT for deployments (MW-9): NEXT_PUBLIC_* vars are inlined at BUILD
# time, so a Docker deployment must pass this as a build arg —
#   docker build --build-arg NEXT_PUBLIC_SITE_URL=https://yourdomain.example …
# (the website Dockerfile wires the arg through). Without it, sitemap.xml,
# robots.txt, canonicals and OG/Twitter URLs all fall back to localhost:3001.
# In integrated mode (basePath /website behind the app's proxy) set this to
# the PUBLIC origin the site is browsed at, e.g. https://yourdomain.example —
# the sitemap then emits https://yourdomain.example/website/<page>.
NEXT_PUBLIC_SITE_URL="https://mjengoos.example.com"

# Optional public contact mailbox (MW-7). Unset by default because no real
# mailbox exists yet — the /contact form is the primary channel (privacy §8
# and terms §10 say exactly that). Build-time inlined like the vars above:
#   docker build --build-arg NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.example …
# NEXT_PUBLIC_CONTACT_EMAIL="hello@yourdomain.example"

# Where "Sign in" points — the actual MjengoOS application.
# When the site is served behind a gateway with the app on the same host
# (as in the preview sandbox), the default "/" is correct. Otherwise set
# the app's public origin, e.g. "https://app.mjengoos.com".
NEXT_PUBLIC_APP_URL="/"

# Optional analytics sink. When set, tracked events are POSTed here as
# JSON ({ event, props, ts, url }). When unset, events are only logged to
# the browser console in development — no analytics provider is contacted.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT="https://analytics.example.com/collect"

# Serve the site under a base path — used in the integrated preview mode,
# where the web app (port 3000) proxies /website/* to this server (port 3001).
# The site then serves pages, assets and its API under that prefix.
# Leave unset for a standalone deployment on its own domain.
# NEXT_PUBLIC_BASE_PATH="/website"

# ── Server runtime (NOT build-time) ───────────────────────────────────────
# TRUST_PROXY (MW-10 + issue #131) — set only when exactly ONE reverse proxy
# that appends the real client IP to x-forwarded-for sits in front of this
# server (nginx `proxy_add_x_forwarded_for`, a load balancer, etc.). Then the
# contact form's rate limit is enforced PER VISITOR: 5/hour keyed on the
# proxy-appended (LAST) x-forwarded-for entry — same semantics as the main
# app's rate limiter — plus a 200/hour global backstop across all visitors.
# UNSET (default): the client-spoofable header is ignored and all traffic
# shares ONE bucket capped at the 200/hour global backstop — launch bursts
# (up to 200 leads/hour) no longer 429 every visitor, while floods still
# fail closed. Trip either layer and the 429 carries a `reason`
# ("rate_limited_visitor" | "rate_limited_global"); the global layer and the
# 500-entry submission cap both log visible warnings.
# Note: the app's /website rewrite proxy does NOT append x-forwarded-for,
# so integrated-mode deployments usually leave this unset too — front the
# whole origin with your own appending proxy if you need per-visitor limits.
# TRUST_PROXY=1
