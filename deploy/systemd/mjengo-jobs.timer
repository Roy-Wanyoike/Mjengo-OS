# MjengoOS — cadence for mjengo-jobs.service: every 5 minutes.
# Install together with mjengo-jobs.service (see its header comment):
#   install -D -m 0644 deploy/systemd/mjengo-jobs.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now mjengo-jobs.timer

[Unit]
Description=Drain MjengoOS background jobs every 5 minutes

[Timer]
# Minute 0, 5, 10, … 55 of every hour — the 5-minute grid (matches the
# compose jobs-tick sidecar's sleep 300, 50x under the endpoint's
# 10/min rate-limit bucket).
OnCalendar=*:0/5
# If the host was down/asleep across one or more scheduled ticks, fire
# ONE catch-up drain immediately on the next boot — safe because a drain
# only ever picks queued/retrying rows that are due (never re-runs done
# jobs; see src/backend/modules/jobs/service.ts).
Persistent=true
# Coalesce ticks onto the grid within 30s (systemd's default 1min is
# coarser than this schedule needs).
AccuracySec=30s

[Install]
WantedBy=timers.target
