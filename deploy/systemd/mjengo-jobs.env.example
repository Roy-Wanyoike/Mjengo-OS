# /etc/mjengo/jobs.env — EnvironmentFile for mjengo-jobs.service.
# Copy from deploy/systemd/mjengo-jobs.env.example, then LOCK IT DOWN:
#   chown root:root /etc/mjengo/jobs.env && chmod 600 /etc/mjengo/jobs.env
# The token is a shared secret (equivalent, for POST /api/jobs/run only,
# to a contractor/admin session) — treat it like a password.

# Where the app is deployed (adjust for your domain/proxy; the default
# matches a same-host standalone server).
MJENGO_JOBS_URL=http://127.0.0.1:3000

# Shared secret authenticating the scheduled drain — REPLACE ME.
# Generate: openssl rand -hex 32
# Must match the app server's JOBS_RUN_TOKEN exactly (the same value in
# the app's .env). Empty/unset = the app rejects every drain with 401.
# Rotation: generate a new value, update the app's env + restart the app
# (docker compose up -d / systemctl restart <app>), then update this
# file — the next tick uses it. A few ticks may 401 during the swap;
# harmless, queued jobs simply wait for the next successful drain.
JOBS_RUN_TOKEN=
