# MjengoOS — cadence for mjengo-backup.service: once a day, 04:30.
# Install together with mjengo-backup.service (see its header comment):
#   install -D -m 0644 deploy/backup/mjengo-backup.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now mjengo-backup.timer

[Unit]
Description=Back up MjengoOS daily (SQLite + volumes)

[Timer]
# 04:30 local time, every day — off the top of the hour and off a
# construction office's working day (change to taste: the backup is
# ONLINE — `.backup` never stops the app — so this is only a quiet
# window, not a maintenance window).
OnCalendar=*-*-* 04:30:00
# Host was down at 04:30? Fire the missed run at the next boot — for
# backups a catch-up is strictly better than a silently skipped day
# (the run is online, idempotent and prunes by age).
Persistent=true
# Coalesce onto the minute (the default 1min window is fine here).
AccuracySec=1min

[Install]
WantedBy=timers.target
