# MjengoOS — environment template
# Copy to `.env` (gitignored — never commit real secrets).

# SQLite database file (Prisma)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth — REQUIRED. Stable secret for JWT session-cookie encryption.
# Generate: openssl rand -hex 32
# Changing it invalidates every existing session (users sign in again).
NEXTAUTH_SECRET=change-me-generate-a-64-hex-secret

# NextAuth — public base URL.
# • Local dev / sandbox preview (reverse proxy): leave UNSET. With
#   AUTH_TRUST_HOST=1, next-auth v4 derives the origin from the request's
#   x-forwarded-host/-proto headers, so sign-in redirects, callback URLs and
#   cookie origins always target the host the user actually browses. Pinning
#   it to localhost breaks sign-in through the preview gateway.
# • Self-hosting on a fixed public domain: set https://your-domain.example
# NEXTAUTH_URL=

# NextAuth — trust the reverse proxy's forwarded host/proto headers.
# REQUIRED behind the sandbox preview gateway (v4 detectOrigin returns
# NEXTAUTH_URL unless VERCEL/AUTH_TRUST_HOST is set — unset both and every
# origin silently degrades to http://localhost:3000, breaking sign-in
# through any proxy). Keep it set whenever the app is reached via a proxy;
# it is equally correct for direct localhost dev.
AUTH_TRUST_HOST=1

# ── Optional hardening (all default OFF — see DEPLOYMENT.md §3) ──────────

# TRUST_PROXY: when set (1/true), the client IP for rate limiting and the
# login lockout is read from the RIGHTMOST x-forwarded-for value (the view
# of a trusted appending reverse proxy), defeating XFF spoofing that mints
# fresh rate-limit buckets. Set only when every hop in front of the app is
# a proxy you control. Unset (local dev / direct exposure) = first value.
# TRUST_PROXY=1

# MUTATION_ORIGIN_ALLOWLIST: comma-separated browser Origins (e.g.
# https://app.example.com,https://example.com). When set, mutating JSON
# routes (POST/PUT/DELETE) additionally verify the request's Origin header
# against this list. Leave unset when the app is embedded in cross-site
# iframes (preview) or used by non-browser clients.
# MUTATION_ORIGIN_ALLOWLIST=

# USSD_WEBHOOK_SECRET: when set, POST /api/ussd must carry
# X-Signature: <hex HMAC-SHA256 of the raw request body> — the aggregator
# trust model for a real telco gateway. Unset = open demo posture (PIN
# attempts are still IP-rate-limited).
# USSD_WEBHOOK_SECRET=

# WEBSITE_ORIGIN: where the web app proxies /website/* to (the marketing
# site). Default http://127.0.0.1:3001 (same-host). Under docker-compose
# set http://website:3001 (service name).
# WEBSITE_ORIGIN=http://127.0.0.1:3001
